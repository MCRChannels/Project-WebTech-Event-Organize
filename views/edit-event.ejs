<%- include('partials/header') %>
<main class="container mb-4">
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4 shadow-sm">
            <h1 class="mb-4">Editing: <%= event.name %></h1>
            <form id="edit-event-form" data-event-id="<%= event._id %>">
                
                <div class="mb-4 text-center">
                    <label class="form-label fw-bold">Current Event Image</label>
                    <div>
                        <img src="<%= event.imageUrl %>" id="image-preview" alt="Current Image" class="img-thumbnail" style="max-width: 300px; margin-bottom: 1rem; border-radius: 10px;">
                    </div>
                    <label for="newImageUrl" class="btn btn-outline-secondary btn-sm">Change Image</label>
                    <input type="file" class="d-none" id="newImageUrl" accept="image/png, image/jpeg">
                </div>

                <div class="mb-3">
                    <label for="name" class="form-label">Event Name</label>
                    <input type="text" class="form-control" id="name" value="<%= event.name %>" required>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description" rows="4" required><%= event.description %></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="date" class="form-label">Date</label>
                        <input type="date" class="form-control" id="date" value="<%= event.date.toISOString().split('T')[0] %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="time" class="form-label">Time</label>
                        <input type="time" class="form-control" id="time" value="<%= event.time %>" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" class="form-control" id="location" value="<%= event.location %>" required>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="ticketAvailable" class="form-label">Tickets Available</label>
                        <input type="number" class="form-control" id="ticketAvailable" value="<%= event.ticketAvailable %>" min="0" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="price" class="form-label">Price (THB)</label>
                        <input type="number" class="form-control" id="price" value="<%= event.price %>" min="0" required>
                    </div>
                </div>

                <div id="edit-event-error" class="alert alert-danger d-none"></div>
                
                <div class="mt-4 d-flex align-items-center">
                    <button type="submit" class="btn btn-dark btn-lg" id="save-changes-btn">
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        Save Changes
                    </button>
                    <a href="/dashboard" class="btn btn-link text-secondary ms-3">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
</main>
<%- include('partials/footer') %>