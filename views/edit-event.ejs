<%- include('partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1><%= pageTitle %></h1>
        <hr>
        <div class="card p-4">
            <form id="edit-event-form" data-event-id="<%= event._id %>">
                <div class="mb-3">
                    <label for="name" class="form-label">Event Name</label>
                    <input type="text" class="form-control" id="name" value="<%= event.name %>" required>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description" rows="3" required><%= event.description %></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="date" class="form-label">Date</label>
                        <input type="date" class="form-control" id="date" value="<%= event.date.toISOString().split('T')[0] %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" class="form-control" id="location" value="<%= event.location %>" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="ticketAvailable" class="form-label">Tickets Available</label>
                        <input type="number" class="form-control" id="ticketAvailable" value="<%= event.ticketAvailable %>" min="0" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="price" class="form-label">Price (THB)</label>
                        <input type="number" class="form-control" id="price" value="<%= event.price %>" min="0" required>
                    </div>
                </div>
                <div id="edit-event-error" class="alert alert-danger d-none"></div>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>