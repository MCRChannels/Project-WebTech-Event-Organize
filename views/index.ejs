<%- include('partials/header') %>

    <% if (nextEvent) { %>
        <div class="hero-section text-white text-center" style="background-image: url('<%= nextEvent.imageUrl %>');"
            data-event-date="<%= nextEvent.date.toISOString() %>" data-event-time="<%= nextEvent.time %>">

            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1>
                    <%= nextEvent.name %>
                </h1>
                <p class="lead">📍 <%= nextEvent.location %>
                </p>

                <div id="hero-countdown" class="d-flex justify-content-center gap-4 my-4">
                    <div class="timer-box">
                        <span id="countdown-days">00</span>
                        <span>Days</span>
                    </div>
                    <div class="timer-box">
                        <span id="countdown-hours">00</span>
                        <span>Hours</span>
                    </div>
                    <div class="timer-box">
                        <span id="countdown-minutes">00</span>
                        <span>Minutes</span>
                    </div>
                    <div class="timer-box">
                        <span id="countdown-seconds">00</span>
                        <span>Seconds</span>
                    </div>
                </div>

                <button class="btn btn-dark btn-lg" id="hero-book-btn" data-event-id="<%= nextEvent._id %>">
                    Book Now
                </button>
            </div>
        </div>
        <% } %>

            <div class="container mt-5">
                <h2>More Upcoming Events</h2>
                <hr>
                <div class="row">
                    <% if (upcomingEvents.length> 0) { %>
                        <% upcomingEvents.forEach(event=> { %>
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 event-card">
                                    <img src="<%= event.imageUrl %>" class="card-img-top" alt="<%= event.name %>"
                                        style="height: 200px; object-fit: cover;">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">
                                            <%= event.name %>
                                        </h5>
                                        <p class="card-text"><small class="text-muted">
                                                <%= new Date(event.date).toLocaleDateString('th-TH') %> at <%=
                                                        event.time %>
                                            </small></p>
                                        <p class="card-text"><small class="text-muted">📍 <%= event.location %></small>
                                        </p>

                                        <div class="mt-auto pt-3 d-flex justify-content-between align-items-center">

                                            <div>
                                                <% if (event.price> 0) { %>
                                                    <span class="fs-5 fw-bold text-black">
                                                        <%= event.price.toLocaleString('en-US') %> <small
                                                                class="text-muted">THB</small>
                                                    </span>
                                                    <% } else { %>
                                                        <span class="badge bg-success fs-6">FREE</span>
                                                        <% } %>
                                            </div>

                                            <button class="btn btn-dark view-details-btn" data-bs-toggle="modal"
                                                data-bs-target="#eventDetailModal" data-event-id="<%= event._id %>">
                                                View Details
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p>No other upcoming events.</p>
                                    <% } %>
                </div>
            </div>

            <div class="modal fade" id="eventDetailModal" tabindex="-1">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-body">
                            <div class="modal-image-container">
                                <img id="modalEventImage" src="" alt="Event Image">
                                <button type="button"
                                    class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                                    data-bs-dismiss="modal"
                                    style="background-color: rgba(0,0,0,0.5); border-radius: 50%;"></button>
                            </div>

                            <div class="modal-info-content">
                                <h2 class="mb-1" id="modalEventName">Event Name Here</h2>
                                <p class="text-muted mb-4">Organized by: <span id="modalEventOrganizer"></span></p>

                                <div id="modalEventCountdown" class="text-center my-4 fs-4 fw-bold text-dark"></div>

                                <div class="row text-center mb-4 modal-info-grid">
                                    <div class="col">
                                        <strong>DATE</strong>
                                        <p id="modalEventDate" class="mb-0"></p>
                                    </div>
                                    <div class="col border-start border-end">
                                        <strong>TIME</strong>
                                        <p id="modalEventTime" class="mb-0"></p>
                                    </div>
                                    <div class="col">
                                        <strong>LOCATION</strong>
                                        <p id="modalEventLocation" class="mb-0"></p>
                                    </div>
                                </div>

                                <h5 class="fw-bold">About this event</h5>
                                <p id="modalEventDescription"></p>
                            </div>
                        </div>

                        <div class="modal-footer d-flex justify-content-between align-items-center">
                            <div>
                                <span id="modal-price-display" class="d-none">
                                    <span class="fs-4 fw-bold" id="modalEventPrice"></span>
                                    <span class="text-muted">THB</span>
                                </span>
                                <span id="modal-free-display" class="d-none">
                                    <span class="badge bg-success fs-4">FREE</span>
                                </span>

                                <span id="ticket-status-container" class="ms-2">
                                    <span class="badge bg-secondary" id="tickets-left-display">
                                        Tickets Left: <span id="modalEventTickets"></span>
                                    </span>
                                    <span class="badge bg-danger fs-6 d-none" id="sold-out-display">
                                        SOLD OUT
                                    </span>
                                </span>
                            </div>

                            <button type="button" class="btn btn-success btn-lg d-none" id="modalBookButton"
                                style="border-radius: 50px;">
                            </button>
                        </div>
                    </div>
                </div>
            </div>



            <%- include('partials/footer') %>