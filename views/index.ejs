<%- include('partials/header') %>

    <h1>
        <%= pageTitle %>
    </h1>
    <hr>

    <div class="row">
        <% if (events.length> 0) { %>
            <% events.forEach(event=> { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="<%= event.imageUrl %>" class="card-img-top" alt="<%= event.name %>"
                            style="height: 200px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <%= event.name %>
                            </h5>
                            <p class="card-text"><small class="text-muted">
                                    <%= new Date(event.date).toLocaleDateString('th-TH') %>
                                </small></p>
                            <p class="card-text"><small class="text-muted">📍 <%= event.location %></small></p>

                            <p class="card-text card-description">
                                <%= event.description.substring(0, 100) %>
                            </p>
                            <button class="btn btn-primary mt-auto view-details-btn" data-bs-toggle="modal"
                                data-bs-target="#eventDetailModal" data-event-id="<%= event._id %>">View
                                Details</button>
                        </div>
                    </div>
                </div>
                <% }) %>
                    <% } else { %>
                        <p>No events found.</p>
                        <% } %>
    </div>

    <div class="modal fade" id="eventDetailModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEventName">Event Name Here</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <img id="modalEventImage" src="" class="img-fluid rounded mb-3" alt="Event Image">
                        </div>
                        <div class="col-md-6">
                            <p><strong>Date:</strong> <span id="modalEventDate"></span></p>
                            <p><strong>Location:</strong> <span id="modalEventLocation"></span></p>
                            <p><strong>Price:</strong> <span id="modalEventPrice"></span> THB</p>
                            <p><strong>Tickets Left:</strong> <span id="modalEventTickets"></span></p>
                            <hr>
                            <p><strong>Description:</strong></p>
                            <p id="modalEventDescription"></p>
                            <hr>
                            <p><strong>Organized by:</strong> <span id="modalEventOrganizer"></span></p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-success d-none" id="modalBookButton">Book This Event</button>
                </div>
            </div>
        </div>
    </div>
    <%- include('partials/footer') %>