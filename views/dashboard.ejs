<%- include('partials/header') %>

<h1>Organizer Dashboard</h1>
<p>Manage your events and view attendee lists.</p>
<hr>

<% if (events && events.length > 0) { %>
    <% events.forEach(event => { %>
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><%= event.name %></h5>
                <div>
                    <a href="/edit-event/<%= event._id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <button class="btn btn-sm btn-outline-danger delete-event-btn" data-event-id="<%= event._id %>">Delete</button>
                </div>
            </div>
            <div class="card-body">
                <p><strong>Date:</strong> <%= new Date(event.date).toLocaleDateString('th-TH') %></p>
                <p><strong>Tickets Sold:</strong> <%= (event.bookings || []).length %> / <%= event.ticketAvailable + (event.bookings || []).length %></p>
                <% if (event.bookings && event.bookings.length > 0) { %>
                    <h6>Attendees:</h6>
                    <ul class="list-group">
                        <% event.bookings.forEach(booking => { %>
                            <li class="list-group-item"><%= booking.firstName %> <%= booking.lastName %> (<%= booking.email %>)</li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p class="text-muted">No one has booked this event yet.</p>
                <% } %>
            </div>
        </div>
    <% }) %>
<% } else { %>
    <div class="alert alert-info">
        You haven't created any events yet. <a href="/create-event">Create your first event now!</a>
    </div>
<% } %>

<%- include('partials/footer') %>