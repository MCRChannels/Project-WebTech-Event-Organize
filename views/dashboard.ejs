<%- include('partials/header') %>

    <h1>Organizer Dashboard</h1>
    <p>Manage your events and view attendee lists.</p>
    <hr>


    <% if (events && events.length> 0) { %>
        <% events.forEach(event=> { %>
            <div class="card mb-4 shadow-sm event-card">
                <div class="row g-0">
                    <div class="col-md-4">
                        <img src="<%= event.imageUrl %>" class="img-fluid rounded-start" alt="<%= event.name %>"
                            style="height: 200px; width: 100%; object-fit: cover;">
                    </div>
                    <div class="col-md-8">
                        <div
                            class="card-header bg-transparent d-flex justify-content-between align-items-center border-bottom-0 pt-3">
                            <h5 class="mb-0">
                                <%= event.name %>
                            </h5>
                            <div>
                                <a href="/edit-event/<%= event._id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <button class="btn btn-sm btn-outline-danger delete-event-btn"
                                    data-event-id="<%= event._id %>">Delete</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <p><strong>Date:</strong>
                                <%= new Date(event.date).toLocaleDateString('th-TH', { year: 'numeric' , month: 'long' ,
                                    day: 'numeric' }) %> at <%= event.time %>
                            </p>
                            <p><strong>Tickets Left:</strong> <span class="badge bg-info">
                                    <%= event.ticketAvailable %>
                                </span></p>

                            <% if (event.attendees && event.attendees.length> 0) { %>
                                <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#attendeeList-<%= event._id %>">
                                    View Attendees (<%= event.attendees.length %>)
                                </button>
                                <div class="collapse mt-3" id="attendeeList-<%= event._id %>">
                                    <ul class="list-group">
                                        <% event.attendees.forEach(attendee=> { %>
                                            <% if (attendee) { %>
                                                <li class="list-group-item">
                                                    <%= attendee.firstName %>
                                                        <%= attendee.lastName %> (<%= attendee.email %>)
                                                </li>
                                                <% } %>
                                                    <% }); %>
                                    </ul>
                                </div>
                                <% } else { %>
                                    <p class="text-muted">No one has booked this event yet.</p>
                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
                <% } else { %>
                    <div class="alert alert-info">
                        You haven't created any events yet. <a href="/create-event">Create your first event now!</a>
                    </div>
                    <% } %>

                        <%- include('partials/footer') %>