<%- include('partials/header') %>

<div class="container my-5">
    <div class="row g-5">
        <div class="col-md-7 col-lg-8">
            <h4 class="mb-3">Booking Confirmation</h4>
            
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5>Buyer Information</h5>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Name:</strong> <%= user.firstName %> <%= user.lastName %></p>
                    <p class="mb-0"><strong>Email:</strong> <%= user.email %></p>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h5>Payment Method</h5>
                </div>
                <div class="card-body">
                    <div class="form-check">
                        <input id="credit" name="paymentMethod" type="radio" class="form-check-input" checked required>
                        <label class="form-check-label" for="credit">Credit card</label>
                    </div>
                    <div class="form-check">
                        <input id="debit" name="paymentMethod" type="radio" class="form-check-input" required>
                        <label class="form-check-label" for="debit">QR PromptPay</label>
                    </div>
                    <div class="form-check">
                        <input id="paypal" name="paymentMethod" type="radio" class="form-check-input" required>
                        <label class="form-check-label" for="paypal">Other e-Wallets</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5 col-lg-4">
            <div class="card shadow-sm sticky-top" style="top: 100px;">
                <div class="card-header py-3">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <img src="<%= event.imageUrl %>" alt="<%= event.name %>" class="me-3" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px;">
                        <div>
                            <h6 class="mb-0"><%= event.name %></h6>
                            <small class="text-muted"><%= new Date(event.date).toLocaleDateString('th-TH') %> at <%= event.time %></small>
                        </div>
                    </div>
                    
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Ticket Price</span>
                            <strong><%= event.price.toLocaleString('en-US') %> THB</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Processing Fee</span>
                            <span class="text-muted">0.00 THB</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between bg-light">
                            <span class="fw-bold">Total</span>
                            <strong class="fs-5"><%= event.price.toLocaleString('en-US') %> THB</strong>
                        </li>
                    </ul>
                </div>
                <div class="card-footer p-3">
                    <p class="text-muted small">Mockup Chei Chei naja</p>
                    <button class="btn btn-dark btn-lg w-100" id="confirm-payment-btn" data-event-id="<%= event._id %>">
                        Confirm Payment
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>