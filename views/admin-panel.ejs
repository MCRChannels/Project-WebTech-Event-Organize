<%- include('partials/header') %>

<h1 class="mb-4">Admin Panel</h1>

<div class="card mb-5 shadow-sm">
    <div class="card-header bg-white py-3">
        <h3 class="mb-0"><i class="fas fa-users me-2"></i>Manage Users (<%= users.length %>)</h3>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <input type="text" id="user-search" class="form-control" placeholder="Search for users by name or email...">
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="user-table-body">
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.firstName %> <%= user.lastName %></td>
                            <td><%= user.email %></td>
                            <td>
                                <% if (user.role !== 'admin') { %>
                                    <select class="form-select form-select-sm user-role-select" data-user-id="<%= user._id %>">
                                        <option value="attendee" <%= user.role === 'attendee' ? 'selected' : '' %>>Attendee</option>
                                        <option value="organizer" <%= user.role === 'organizer' ? 'selected' : '' %>>Organizer</option>
                                    </select>
                                <% } else { %>
                                    <span class="badge bg-primary">Admin</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <% if (user.role !== 'admin') { %>
                                    <button class="btn btn-sm btn-success save-role-btn d-none" data-user-id="<%= user._id %>">Save</button>
                                    <button class="btn btn-sm btn-outline-danger admin-delete-user-btn" data-user-id="<%= user._id %>">Delete</button>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h3 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Manage Events (<%= events.length %>)</h3>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <input type="text" id="event-search" class="form-control" placeholder="Search for events by name...">
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Organizer</th>
                        <th>Date</th>
                        <th>Tickets Left</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="event-table-body">
                    <% events.forEach(event => { %>
                        <tr>
                            <td><%= event.name %></td>
                            <td>
                                <% if (event.organizer) { %>
                                    <%= event.organizer.firstName %> <%= event.organizer.lastName %>
                                <% } else { %>
                                    <span class="text-danger">Not Found</span>
                                <% } %>
                            </td>
                            <td><%= new Date(event.date).toLocaleDateString('th-TH') %></td>
                            <td><%= event.ticketAvailable %></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger admin-delete-event-btn" data-event-id="<%= event._id %>">Delete</button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

<%- include('partials/footer') %>