<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Organizer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body data-user-role="<%= (typeof user !== 'undefined' && user) ? user.role : 'guest' %>">
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">EventTick</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">

                    <% if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item">
                            <span class="navbar-text me-3">
                                💰 Wallet: <span class="badge bg-success">
                                    <%= user.walletBalance.toLocaleString('en-US') %> THB
                                </span>
                            </span>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                                data-bs-toggle="dropdown">
                                Welcome, <%= user.firstName %>
                            </a>
                            
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/profile">My Profile</a></li>
                                
                                <% if (user.role === 'attendee') { %>
                                    <li><a class="dropdown-item" href="/my-bookings">My Bookings</a></li>
                                <% } %>
                                
                                <% if (user.role === 'organizer') { %>
                                    <li><a class="dropdown-item" href="/dashboard">My Dashboard</a></li>
                                    <li><a class="dropdown-item" href="/create-event">Create Event</a></li>
                                <% } %>
                                
                                <% if (user.role === 'admin') { %>
                                    <li><a class="dropdown-item" href="/admin-panel">Admin Panel</a></li>
                                <% } %>
                                
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="#" id="logout-link">Logout</a></li>
                            </ul>
                            </li>

                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Login</a>
                        </li>
                    <% } %>

                </ul>
            </div>
        </div>
    </nav>
    <main class="container mt-4">