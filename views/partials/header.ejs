<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Organizer</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body data-user-role="<%= (typeof user !== 'undefined' && user) ? user.role : 'guest' %>">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fs-4" href="/">EventPass</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">

                <div class="position-relative me-auto">
                    <form class="d-flex navbar-search-form" action="/search" method="GET">
                        <input class="form-control " id="navbar-search-input" type="search" name="q"
                            placeholder="Search for events..." autocomplete="off">
                    </form>
                    <div class="list-group position-absolute w-100 top-100 start-0 shadow-lg d-none"
                        id="search-results-list"></div>
                </div>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">

                    <% if (typeof user !=='undefined' && user) { %>
                        <% if (user.role==='admin' ) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/scanner">Scan Ticket</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin-panel">Admin Panel</a>
                            </li>
                            <% } %>

                                <% if (user.role==='organizer' ) { %>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/dashboard">Dashboard</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/create-event">Create Event</a>
                                    </li>
                                    <% } %>

                                        <% if (user.role==='attendee' ) { %>
                                            <li class="nav-item">
                                                <a class="nav-link" href="/my-bookings">My Bookings</a>
                                            </li>
                                            <% } %>

                                                <li class="nav-item dropdown">
                                                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown"
                                                        role="button" data-bs-toggle="dropdown">
                                                        Welcome, <%= user.firstName %>
                                                    </a>
                                                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                                        <li><a class="dropdown-item" href="/profile">My Profile</a></li>
                                                        <li>
                                                            <hr class="dropdown-divider">
                                                        </li>
                                                        <li><a class="dropdown-item" href="#"
                                                                id="logout-link">Logout</a></li>
                                                    </ul>
                                                </li>

                                                <% } else { %>
                                                    <li class="nav-item">
                                                        <a class="btn btn-outline-light btn-login" href="/login">Login /
                                                            Register</a>
                                                    </li>
                                                    <% } %>

                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">